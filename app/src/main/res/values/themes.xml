<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole UI, so the platform theme only has to set the
         window chrome to the same dark tone the app uses. -->
    <style name="Theme.LeafDiag" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
